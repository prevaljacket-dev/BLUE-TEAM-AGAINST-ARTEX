# Cle obligatoire pour l'API (en-tete X-API-Key). Generez-la : python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SOAR_API_KEY=changez-moi
# dry_run (defaut) ou enforce. Ne passez en enforce qu'apres validation des playbooks.
SOAR_MODE=dry_run
# Agent "shipper" (profil optionnel)
NGINX_LOG_DIR=/var/log/nginx
SOAR_TARGET=web01
# Connecteur webhook (si active dans config/soar.yml)
# SOAR_WEBHOOK_URL=https://hooks.slack.com/services/...
